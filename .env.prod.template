# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# ⚠️  IMPORTANT: NEVER COMMIT THIS FILE TO GIT!
# ============================================================================
# Copy this template to .env.prod and fill in actual production values
# Make sure .env.prod is in your .gitignore

# ============================================================================
# CORE DJANGO SETTINGS (REQUIRED)
# ============================================================================
# Generate a strong secret key using:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=

# Production domains (comma-separated, no spaces)
# Example: yourdomain.com,www.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED - PostgreSQL)
# ============================================================================
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=17682
SSL_MODE=require

# ============================================================================
# REDIS CONFIGURATION (REQUIRED)
# ============================================================================
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ============================================================================
# EMAIL CONFIGURATION (REQUIRED)
# ============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=WasteWorth <no-reply@wasteworth.com>
EMAIL_TIMEOUT=120

# ============================================================================
# CORS CONFIGURATION (REQUIRED)
# ============================================================================
# Production frontend URLs (comma-separated, must use HTTPS)
# Example: https://wasteworth.com,https://www.wasteworth.com
CORS_ALLOWED_ORIGINS=

# ============================================================================
# PAYSTACK PAYMENT GATEWAY (REQUIRED - LIVE KEYS)
# ============================================================================
# ⚠️  Must use LIVE keys in production (sk_live_..., pk_live_...)
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=

# ============================================================================
# FRONTEND & MICROSERVICES (REQUIRED)
# ============================================================================
FRONTEND_URL=
NODE_SERVICE_URL=
INTERNAL_API_KEY=

# ============================================================================
# CLOUDINARY FILE STORAGE (REQUIRED)
# ============================================================================
# Format: cloudinary://api_key:api_secret@cloud_name
# Get from: https://cloudinary.com/console
CLOUDINARY_URL=

# ============================================================================
# OPTIONAL: MONITORING & ERROR TRACKING
# ============================================================================
# Uncomment if using Sentry
# SENTRY_DSN=

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying, verify:
# [ ] SECRET_KEY is a strong random value (not the development key)
# [ ] ALLOWED_HOSTS contains your actual production domain(s)
# [ ] DATABASE credentials are for production PostgreSQL
# [ ] REDIS credentials are for production Redis
# [ ] EMAIL credentials are valid and tested
# [ ] CORS_ALLOWED_ORIGINS uses HTTPS (not HTTP)
# [ ] PAYSTACK keys are LIVE keys (sk_live_..., pk_live_...)
# [ ] CLOUDINARY_URL is configured
# [ ] INTERNAL_API_KEY is a strong random value
# [ ] This file (.env.prod) is in .gitignore
# [ ] FRONTEND_URL points to production frontend
