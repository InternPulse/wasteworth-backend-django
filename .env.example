# Environment Configuration Template for WasteWorth Backend
# Copy this file to create your environment-specific configuration:
# - For development: Copy to .env.dev (can be committed)
# - For production: Copy to .env.prod (NEVER commit)

# ============================================================================
# CORE DJANGO SETTINGS
# ============================================================================
SECRET_KEY=your-secret-key-here-generate-with-django
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For development: SQLite is used by default (no configuration needed)
# For production: PostgreSQL is required
DATABASE_NAME=wasteworth_db
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=your-db-host
DATABASE_PORT=5432
SSL_MODE=require

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Required for caching, rate limiting, and background jobs
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Development: Uses console backend (prints to terminal)
# Production: Requires SMTP configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=YourApp <no-reply@example.com>
EMAIL_TIMEOUT=120

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
# Development: http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# PAYSTACK PAYMENT GATEWAY
# ============================================================================
# Development: Use test keys (sk_test_..., pk_test_...)
# Production: Use live keys (sk_live_..., pk_live_...)
# Get keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_or_live_key_here
PAYSTACK_PUBLIC_KEY=pk_test_or_live_key_here
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback

# ============================================================================
# FRONTEND & MICROSERVICES
# ============================================================================
# Frontend URL for generating referral links and payment callbacks
FRONTEND_URL=http://localhost:3000

# Node.js service integration (if applicable)
NODE_SERVICE_URL=http://localhost:3000
INTERNAL_API_KEY=your-internal-api-key

# ============================================================================
# CLOUDINARY FILE STORAGE
# ============================================================================
# Get credentials from: https://cloudinary.com/console
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ============================================================================
# OPTIONAL: MONITORING & ERROR TRACKING
# ============================================================================
# Uncomment if using Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# NOTES FOR PRODUCTION
# ============================================================================
# 1. Generate SECRET_KEY using:
#    python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
#
# 2. Set ALLOWED_HOSTS to your actual domain(s):
#    ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
#
# 3. Use Paystack LIVE keys (not test keys) in production
#
# 4. Never commit .env.prod to version control!
#
# 5. Update CORS_ALLOWED_ORIGINS to use HTTPS in production:
#    CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
